interseccion <- st_intersection(dual_sf, dominio_sf)
# ===== ETAPA 4 (versión sf + geometrías reparadas) =====
library(sf)
dual <- book.mesh.dual(malla)
# --- Convertir a sf Y REPARAR ---
dual_sf <- st_make_valid(st_as_sf(dual))
# --- Dominio: construir, cerrar el anillo y reparar ---
coords_borde <- as.matrix(borde_km)
# Asegurar que el primer y último punto coincidan (cerrar el polígono)
if (!all(coords_borde[1, ] == coords_borde[nrow(coords_borde), ])) {
coords_borde <- rbind(coords_borde, coords_borde[1, ])
}
dominio_sf <- st_make_valid(st_sfc(st_polygon(list(coords_borde))))
# --- Comprobar validez antes de intersectar ---
cat("¿Dominio válido?:", st_is_valid(dominio_sf), "\n")
cat("¿Todos los duales válidos?:", all(st_is_valid(dual_sf)), "\n")
# --- Pesos con precisión reducida (evita conflictos de topología) ---
interseccion <- st_intersection(dual_sf, dominio_sf)
pesos <- rep(0, length(dual))
idx <- as.integer(rownames(interseccion))
pesos[idx] <- as.numeric(st_area(interseccion))
cat("Nº de pesos:", length(pesos), "\n")
cat("Nodos con peso > 0:", sum(pesos > 0), "\n")
cat("Suma de pesos (≈ área en km²):", round(sum(pesos)), "\n")
# ===== ETAPA 5A: VECTOR DE RESPUESTA Y EXPOSICIÓN =====
n_puntos <- nrow(coords_km)     # 1835 ocurrencias
n_nodos  <- spde$n.spde         # 3934 nodos
# Respuesta: 0 para los nodos de integración, 1 para las ocurrencias reales
y_pp <- rep(0:1, c(n_nodos, n_puntos))
# Exposición (E): los pesos para los nodos, 0 para las ocurrencias
e_pp <- c(pesos, rep(0, n_puntos))
cat("Longitud de y_pp:", length(y_pp), "(debe ser", n_nodos + n_puntos, ")\n")
cat("Total de unos (ocurrencias):", sum(y_pp), "(debe ser 1835)\n")
# ===== ETAPA 5B: MATRIZ DE PROYECCIÓN Y STACK =====
# Proyección para los nodos de integración: matriz identidad (cada nodo es él mismo)
A_int <- Diagonal(n_nodos, rep(1, n_nodos))
# Proyección para las ocurrencias: ubica cada punto en su triángulo de la malla
A_y <- inla.spde.make.A(mesh = malla, loc = coords_km)
# Apilar ambas matrices de proyección
A_pp <- rbind(A_int, A_y)
# Índice del campo espacial
idx_spde <- inla.spde.make.index("campo_espacial", n.spde = spde$n.spde)
# Construir el 'stack': empaqueta respuesta, exposición, proyección y efectos
stk_pp <- inla.stack(
data    = list(y = y_pp, e = e_pp),
A       = list(1, A_pp),
effects = list(
list(intercept = rep(1, n_nodos + n_puntos)),   # intercepto β₀
list(campo_espacial = idx_spde$campo_espacial)  # el campo Matérn
),
tag = "pp"
)
cat("Stack construido.\n")
# ===== ETAPA 5C: AJUSTAR EL LGCP BASE =====
formula_lgcp <- y ~ 0 + intercept + f(campo_espacial, model = spde)
modelo_lgcp <- inla(
formula_lgcp,
family            = "poisson",
data              = inla.stack.data(stk_pp),
control.predictor = list(A = inla.stack.A(stk_pp)),
E                 = inla.stack.data(stk_pp)$e,
control.compute   = list(dic = TRUE, waic = TRUE)
)
cat("Tiempo de ajuste:", modelo_lgcp$cpu.used["Total"], "segundos\n")
summary(modelo_lgcp)
# Diagnóstico rápido del modelo ajustado
cat("Rango:", modelo_lgcp$summary.hyperpar["Range for campo_espacial", "mean"], "\n")
cat("Stdev:", modelo_lgcp$summary.hyperpar["Stdev for campo_espacial", "mean"], "\n")
# Ver el rango de valores del campo espacial estimado
campo <- modelo_lgcp$summary.random$campo_espacial$mean
cat("Campo espacial - min:", round(min(campo),2), " max:", round(max(campo),2), "\n")
# Marginal log-likelihood (para comparación de modelos, es lo fiable aquí)
cat("Marginal log-Likelihood:", modelo_lgcp$mlik[1], "\n")
# ===== ETAPA 3 (v2): SPDE CON PRIORES MÁS INFORMADOS =====
# Rango mediano esperado ~ el que sugiere Ripley (usamos la extensión del área como referencia)
# El área mide ~300 km de largo; un rango de 15-20 km es ~5-7% de esa extensión.
spde <- inla.spde2.pcmatern(
mesh = malla,
alpha = 2,
# Prior sobre el RANGO: P(rango < 15 km) = 0.5  -> mediana en torno a 15 km
prior.range = c(15, 0.5),
# Prior sobre SIGMA mucho más restrictivo: P(sigma > 1.5) = 0.01
prior.sigma = c(1.5, 0.01)
)
cat("SPDE v2 definido. Nodos:", spde$n.spde, "\n")
# ===== ETAPA 5B: MATRIZ DE PROYECCIÓN Y STACK =====
# Proyección para los nodos de integración: matriz identidad (cada nodo es él mismo)
A_int <- Diagonal(n_nodos, rep(1, n_nodos))
# Proyección para las ocurrencias: ubica cada punto en su triángulo de la malla
A_y <- inla.spde.make.A(mesh = malla, loc = coords_km)
# Apilar ambas matrices de proyección
A_pp <- rbind(A_int, A_y)
# Índice del campo espacial
idx_spde <- inla.spde.make.index("campo_espacial", n.spde = spde$n.spde)
# Construir el 'stack': empaqueta respuesta, exposición, proyección y efectos
stk_pp <- inla.stack(
data    = list(y = y_pp, e = e_pp),
A       = list(1, A_pp),
effects = list(
list(intercept = rep(1, n_nodos + n_puntos)),   # intercepto β₀
list(campo_espacial = idx_spde$campo_espacial)  # el campo Matérn
),
tag = "pp"
)
cat("Stack construido.\n")
# ===== ETAPA 5C: AJUSTAR EL LGCP BASE =====
formula_lgcp <- y ~ 0 + intercept + f(campo_espacial, model = spde)
modelo_lgcp <- inla(
formula_lgcp,
family            = "poisson",
data              = inla.stack.data(stk_pp),
control.predictor = list(A = inla.stack.A(stk_pp)),
E                 = inla.stack.data(stk_pp)$e,
control.compute   = list(dic = TRUE, waic = TRUE)
)
cat("Tiempo de ajuste:", modelo_lgcp$cpu.used["Total"], "segundos\n")
summary(modelo_lgcp)
# Diagnóstico de la escala de los pesos y del campo
cat("Suma de pesos:", round(sum(pesos)), "\n")
cat("Peso máximo:", round(max(pesos), 2), "\n")
cat("Peso mediano (de los > 0):", round(median(pesos[pesos>0]), 2), "\n")
campo <- modelo_lgcp$summary.random$campo_espacial$mean
cat("Campo - min:", round(min(campo),2), " max:", round(max(campo),2), "\n")
# ¿Cuántas ocurrencias y cuántos nodos de integración?
cat("Ocurrencias (unos):", sum(y_pp), " | Nodos integración:", length(pesos), "\n")
# Ver el campo SOLO en los nodos dentro del área (peso > 0)
campo <- modelo_lgcp$summary.random$campo_espacial$mean
campo_dentro <- campo[pesos > 0]
cat("Campo DENTRO del área - min:", round(min(campo_dentro),2),
" max:", round(max(campo_dentro),2), "\n")
cat("Campo DENTRO - mediana:", round(median(campo_dentro),2),
" sd:", round(sd(campo_dentro),2), "\n")
# ===== MAPEAR EL CAMPO ESPACIAL DENTRO DEL ÁREA =====
library(sf)
# Crear una grilla de predicción dentro del área (en km)
area_km <- st_sfc(st_polygon(list(as.matrix(borde_km))))
bbox <- st_bbox(area_km)
# Grilla regular de ~1 km
grid_x <- seq(bbox["xmin"], bbox["xmax"], by = 1)
grid_y <- seq(bbox["ymin"], bbox["ymax"], by = 1)
pred_grid <- expand.grid(x = grid_x, y = grid_y)
# Quedarnos solo con los puntos dentro del área
pts <- st_as_sf(pred_grid, coords = c("x","y"))
dentro <- st_within(pts, area_km, sparse = FALSE)[,1]
pred_grid <- pred_grid[dentro, ]
# Matriz de proyección de la malla a la grilla
A_pred <- inla.spde.make.A(mesh = malla,
loc = as.matrix(pred_grid[, c("x","y")]))
# Proyectar el campo espacial (media) a la grilla
campo_pred <- as.vector(A_pred %*% modelo_lgcp$summary.random$campo_espacial$mean)
# La intensidad esperada = exp(intercepto + campo)
intercepto <- modelo_lgcp$summary.fixed["intercept", "mean"]
intensidad <- exp(intercepto + campo_pred)
pred_grid$campo     <- campo_pred
pred_grid$intensidad <- intensidad
cat("Campo proyectado - min:", round(min(campo_pred),2),
" max:", round(max(campo_pred),2), "\n")
cat("Intensidad - min:", round(min(intensidad),4),
" max:", round(max(intensidad),2), "\n")
# Mapa rápido del campo espacial (fertilidad latente continua)
library(ggplot2)
ggplot(pred_grid, aes(x, y, fill = campo)) +
geom_raster() +
scale_fill_viridis_c(option = "inferno") +
coord_equal() +
labs(title = "Campo espacial latente (LGCP base)",
subtitle = "Fertilidad continua - escala log",
fill = "campo S(s)") +
theme_minimal()
# ¿Cuántos puntos de la grilla tienen valores extremos?
cat("Puntos de grilla con campo > 10:", sum(campo_pred > 10), "de", length(campo_pred), "\n")
cat("Percentil 99 del campo:", round(quantile(campo_pred, 0.99), 2), "\n")
cat("Percentil 95 del campo:", round(quantile(campo_pred, 0.95), 2), "\n")
cat("Mediana del campo:", round(median(campo_pred), 2), "\n")
# ===== ETAPA 5A (v2): NORMALIZAR LOS PESOS =====
n_puntos <- nrow(coords_km)
n_nodos  <- spde$n.spde
# --- NORMALIZAR los pesos: dividir por la media de los pesos > 0 ---
peso_medio <- mean(pesos[pesos > 0])
pesos_norm <- pesos / peso_medio
cat("Peso medio original:", round(peso_medio,2),
"| Pesos normalizados - mediana:", round(median(pesos_norm[pesos_norm>0]),3), "\n")
# Respuesta y exposición CON PESOS NORMALIZADOS
y_pp <- rep(0:1, c(n_nodos, n_puntos))
e_pp <- c(pesos_norm, rep(0, n_puntos))   # <- usa pesos_norm
# ===== ETAPA 5B: MATRIZ DE PROYECCIÓN Y STACK =====
# Proyección para los nodos de integración: matriz identidad (cada nodo es él mismo)
A_int <- Diagonal(n_nodos, rep(1, n_nodos))
# Proyección para las ocurrencias: ubica cada punto en su triángulo de la malla
A_y <- inla.spde.make.A(mesh = malla, loc = coords_km)
# Apilar ambas matrices de proyección
A_pp <- rbind(A_int, A_y)
# Índice del campo espacial
idx_spde <- inla.spde.make.index("campo_espacial", n.spde = spde$n.spde)
# Construir el 'stack': empaqueta respuesta, exposición, proyección y efectos
stk_pp <- inla.stack(
data    = list(y = y_pp, e = e_pp),
A       = list(1, A_pp),
effects = list(
list(intercept = rep(1, n_nodos + n_puntos)),   # intercepto β₀
list(campo_espacial = idx_spde$campo_espacial)  # el campo Matérn
),
tag = "pp"
)
cat("Stack construido.\n")
# ===== ETAPA 5C (limpia) =====
formula_lgcp <- y ~ 0 + intercept + f(campo_espacial, model = spde)
modelo_lgcp <- inla(
formula_lgcp,
family            = "poisson",
data              = inla.stack.data(stk_pp),
control.predictor = list(A = inla.stack.A(stk_pp)),
E                 = inla.stack.data(stk_pp)$e,
control.compute   = list(dic = TRUE, waic = TRUE)
)
summary(modelo_lgcp)
# Verificar dimensiones de las piezas del modelo
cat("Longitud y_pp:", length(y_pp), "\n")
cat("Longitud e_pp:", length(e_pp), "\n")
cat("dim A_int:", dim(A_int), "\n")
cat("dim A_y:", dim(A_y), "\n")
cat("dim A_pp:", dim(A_pp), "\n")
cat("n_nodos:", n_nodos, "| n_puntos:", n_puntos, "\n")
cat("Filas A_pp deben ser n_nodos+n_puntos =", n_nodos + n_puntos, "\n")
# Verificar el stack
cat("\n--- Stack ---\n")
cat("dim A del stack:", dim(inla.stack.A(stk_pp)), "\n")
cat("Longitud data y:", length(inla.stack.data(stk_pp)$y), "\n")
# ===== INTENTO ROBUSTO: intercepto controlado + integración estable =====
modelo_test <- inla(
y ~ 0 + intercept + f(campo_espacial, model = spde),
family            = "poisson",
data              = inla.stack.data(stk_pp),
control.predictor = list(A = inla.stack.A(stk_pp)),
E                 = inla.stack.data(stk_pp)$e,
control.fixed     = list(prec = list(intercept = 0.001)),
control.inla      = list(strategy = "gaussian", int.strategy = "eb"),
control.compute   = list(dic = TRUE, waic = TRUE),
verbose           = FALSE
)
cat("Stdev:", round(modelo_test$summary.hyperpar["Stdev for campo_espacial","mean"],2), "\n")
cat("Range:", round(modelo_test$summary.hyperpar["Range for campo_espacial","mean"],2), "\n")
# Y el chequeo real: el campo proyectado
campo2 <- as.vector(A_pred %*% modelo_test$summary.random$campo_espacial$mean)
cat("Campo proyectado - P99:", round(quantile(campo2,0.99),2),
" mediana:", round(median(campo2),2), "\n")
# Solo si lo anterior falla: verificar que A_y proyecta bien
cat("Suma por fila de A_y (debe ser ~1):", round(mean(rowSums(A_y)),4), "\n")
# ===== MALLA MÁS GRUESA (max.edge > rango) =====
contorno <- inla.nonconvex.hull(coords_km, convex = -0.04, concave = -0.04)
malla <- inla.mesh.2d(
boundary = contorno,
max.edge = c(20, 60),    # interior 20 km (> rango de ~7-16) -> fuerza suavidad
cutoff   = 8,            # fusiona nodos a < 8 km
offset   = c(10, 50)
)
cat("Nodos de la nueva malla:", malla$n, "(esperamos MUCHOS menos, ~500-1000)\n")
plot(malla, main="Malla gruesa para LGCP")
points(coords_km, col="red", pch=19, cex=0.3)
# ===== RECONSTRUIR TODO CON LA MALLA GRUESA =====
# 1) SPDE (con priores sensatos)
spde <- inla.spde2.pcmatern(
mesh = malla, alpha = 2,
prior.range = c(15, 0.5),      # mediana del rango ~15 km
prior.sigma = c(1, 0.01)       # sigma controlado
)
# 2) Malla dual y pesos (con la función y el dominio que ya tienes)
dual    <- book.mesh.dual(malla)
dual_sf <- st_make_valid(st_as_sf(dual))
interseccion <- st_intersection(dual_sf, dominio_sf)
pesos <- rep(0, length(dual))
idx <- as.integer(rownames(interseccion))
pesos[idx] <- as.numeric(st_area(interseccion))
cat("Suma de pesos (debe seguir ~59197):", round(sum(pesos)), "\n")
# 3) Vectores respuesta/exposición
n_puntos <- nrow(coords_km); n_nodos <- spde$n.spde
y_pp <- rep(0:1, c(n_nodos, n_puntos))
e_pp <- c(pesos, rep(0, n_puntos))
# 4) Proyección y stack
A_int <- Diagonal(n_nodos, rep(1, n_nodos))
A_y   <- inla.spde.make.A(mesh = malla, loc = coords_km)
A_pp  <- rbind(A_int, A_y)
idx_spde <- inla.spde.make.index("campo_espacial", n.spde = spde$n.spde)
stk_pp <- inla.stack(
data = list(y = y_pp, e = e_pp),
A = list(1, A_pp),
effects = list(list(intercept = rep(1, n_nodos + n_puntos)),
list(campo_espacial = idx_spde$campo_espacial)),
tag = "pp")
# 5) Ajuste
modelo_lgcp <- inla(
y ~ 0 + intercept + f(campo_espacial, model = spde),
family = "poisson",
data = inla.stack.data(stk_pp),
control.predictor = list(A = inla.stack.A(stk_pp)),
E = inla.stack.data(stk_pp)$e,
control.compute = list(dic = TRUE, waic = TRUE))
cat("Stdev:", round(modelo_lgcp$summary.hyperpar["Stdev for campo_espacial","mean"],2), "\n")
cat("Range:", round(modelo_lgcp$summary.hyperpar["Range for campo_espacial","mean"],2), "\n")
# Instalar (una sola vez)
install.packages("inlabru")
# ===== PREPARACIÓN PARA INLABRU =====
# 1) Puntos como objeto sf (en km, igual que trabajamos)
#    coords_km es tu matriz N x 2 en kilómetros
puntos_sf <- st_as_sf(data.frame(x = coords_km[,1], y = coords_km[,2]),
coords = c("x", "y"))
library(sf)
library(INLA)
library(inlabru)
cat("sf cargado:", "sf" %in% (.packages()), "\n")
cat("INLA cargado:", "INLA" %in% (.packages()), "\n")
cat("inlabru cargado:", "inlabru" %in% (.packages()), "\n")
cat("¿Existe coords_km?:", exists("coords_km"), "\n")
cat("¿Existe borde_km?:", exists("borde_km"), "\n")
# ===== PREPARACIÓN PARA INLABRU =====
# 1) Puntos como objeto sf (en km, igual que trabajamos)
#    coords_km es tu matriz N x 2 en kilómetros
puntos_sf <- st_as_sf(data.frame(x = coords_km[,1], y = coords_km[,2]),
coords = c("x", "y"))
cat("Puntos sf:", nrow(puntos_sf), "\n")
# 2) Reconstruir la malla FINA original (la de 3934 nodos funcionaba bien
#    en estructura; el problema era el ajuste manual, no la malla).
contorno <- inla.nonconvex.hull(coords_km, convex = -0.04, concave = -0.04)
malla <- inla.mesh.2d(
boundary = contorno,
max.edge = c(8, 40),
cutoff   = 4,
offset   = c(8, 40)
)
cat("Nodos de la malla:", malla$n, "\n")
# 3) SPDE con priores sensatos (los que ya razonamos)
spde <- inla.spde2.pcmatern(
mesh = malla, alpha = 2,
prior.range = c(15, 0.5),    # mediana del rango ~15 km
prior.sigma = c(1, 0.01)     # sigma controlado
)
# ===== AJUSTE LGCP CON INLABRU =====
# Definir el dominio de integración a partir del contorno del área (en km)
dominio_sf <- st_sfc(st_polygon(list(as.matrix(borde_km))))
dominio_sf <- st_make_valid(dominio_sf)
# Componentes del modelo: campo espacial + intercepto
cmp <- geometry ~ campo(geometry, model = spde) + Intercept(1)
# Ajustar el LGCP
modelo_bru <- lgcp(
components = cmp,
data       = puntos_sf,
samplers   = dominio_sf,     # el área sobre la que se integra
domain     = list(geometry = malla)
)
# --- Dominio como objeto sf con columna 'geometry' nombrada ---
dominio_sf <- st_sf(
geometry = st_sfc(st_make_valid(st_polygon(list(as.matrix(borde_km)))))
)
# Verificar que la columna de geometría se llame 'geometry'
cat("Nombre de la columna de geometría:", attr(dominio_sf, "sf_column"), "\n")
# --- Ajuste LGCP ---
cmp <- geometry ~ campo(geometry, model = spde) + Intercept(1)
modelo_bru <- lgcp(
components = cmp,
data       = puntos_sf,
samplers   = dominio_sf,          # ahora es un sf con geometry nombrada
domain     = list(geometry = malla)
)
summary(modelo_bru)
# ===== MAPA DE INTENSIDAD (LGCP con inlabru) =====
library(ggplot2)
# Crear grilla de predicción dentro del dominio (en km)
pixels_pred <- fm_pixels(malla, mask = dominio_sf, dims = c(200, 200))
# Predecir la intensidad (en escala log y natural)
pred <- predict(modelo_bru, pixels_pred, ~ campo + Intercept)
# Verificar que ya NO hay picos absurdos
cat("Predicción (log intensidad) - min:", round(min(pred$mean),2),
" max:", round(max(pred$mean),2),
" mediana:", round(median(pred$mean),2), "\n")
# Mapa del campo latente + intercepto (log-intensidad = prospectividad)
ggplot() +
gg(pred, aes(fill = mean), geom = "tile") +
scale_fill_viridis_c(option = "inferno") +
coord_equal() +
labs(title = "Mapa de prospectividad de Au (LGCP - inlabru)",
subtitle = "Log-intensidad esperada (superficie continua)",
fill = "log λ(s)") +
theme_minimal()
library(sf)
# Cargar la retícula con litología y pasarla a km
reticula_lito <- st_read("reticula_lito.gpkg")
reticula_lito <- st_transform(reticula_lito, st_crs(puntos))
geom_km <- st_geometry(reticula_lito) / 1000
reticula_km <- st_sf(lito_grupo = reticula_lito$lito_grupo, geometry = geom_km)
st_crs(reticula_km) <- NA
cat("Clases en la retícula:\n"); print(table(reticula_km$lito_grupo))
# Función: dada una coordenada (x,y en km), devuelve el lito_grupo de su celda
f_lito <- function(x, y) {
pts <- st_sf(geometry = st_sfc(lapply(1:length(x),
function(i) st_point(c(x[i], y[i])))))
idx <- st_intersects(pts, reticula_km)
clase <- sapply(idx, function(i) if(length(i)>0) reticula_km$lito_grupo[i[1]] else NA)
clase[is.na(clase)] <- "Volcanica"    # referencia para huecos
factor(clase, levels = c("Volcanica","Intrusiva","Metamorfica",
"Mafico_Ultramafica","Sed_Cobertura"))
}
# Probar
prueba <- f_lito(coords_km[1:5,1], coords_km[1:5,2])
cat("Prueba de litología en los primeros 5 puntos:\n"); print(prueba)
# --- Función que inlabru llamará: recibe geometría y devuelve la litología ---
lito_eval <- function(geometry) {
coords <- st_coordinates(geometry)
f_lito(coords[,1], coords[,2])
}
# --- Componentes del modelo: campo espacial + litología + intercepto ---
cmp_lito <- geometry ~
campo(geometry, model = spde) +
lito(lito_eval(.data.), model = "factor_contrast") +
Intercept(1)
# --- Ajustar el LGCP con litología ---
modelo_bru_lito <- lgcp(
components = cmp_lito,
data       = puntos_sf,
samplers   = dominio_sf,
domain     = list(geometry = malla)
)
summary(modelo_bru_lito)
# Ver el efecto de litología (quedó como "random")
modelo_bru_lito$summary.random$lito
# --- Componente de litología como EFECTO FIJO con contrastes ---
cmp_lito <- geometry ~
campo(geometry, model = spde) +
lito(lito_eval(.data.), model = "fixed") +      # <- "fixed" en vez de factor_contrast
Intercept(1)
modelo_bru_lito <- lgcp(
components = cmp_lito,
data       = puntos_sf,
samplers   = dominio_sf,
domain     = list(geometry = malla)
)
cat("=== LGCP CON LITOLOGÍA ===\n")
cat("Range:", round(modelo_bru_lito$summary.hyperpar["Range for campo","mean"],2), "km\n")
cat("Stdev:", round(modelo_bru_lito$summary.hyperpar["Stdev for campo","mean"],2), "\n")
cat("Intercepto:", round(modelo_bru_lito$summary.fixed["Intercept","mean"],2), "\n\n")
cat("Efectos de litología (vs. Volcanica):\n")
print(round(modelo_bru_lito$summary.random$lito[,c("ID","mean","0.025quant","0.975quant")], 3))
library(ggplot2)
# Grilla de predicción dentro del dominio
pixels_pred <- fm_pixels(malla, mask = dominio_sf, dims = c(200, 200))
# Predecir la intensidad COMPLETA: campo + litología + intercepto
# La litología se evalúa en cada píxel con la misma función
pred_lito <- predict(
modelo_bru_lito,
pixels_pred,
~ campo + lito_eval(.data.) + Intercept
)
library(ggplot2)
# 1) Crear la grilla de predicción
pixels_pred <- fm_pixels(malla, mask = dominio_sf, dims = c(200, 200))
# 2) Pre-calcular la litología de cada píxel y añadirla como columna
coords_pix <- st_coordinates(pixels_pred)
pixels_pred$lito <- f_lito(coords_pix[,1], coords_pix[,2])
cat("Litología asignada a los píxeles:\n")
print(table(pixels_pred$lito))
# 3) Predecir usando la columna 'lito' ya calculada (no la función)
pred_lito <- predict(
modelo_bru_lito,
pixels_pred,
~ campo + lito + Intercept    # <- 'lito' ahora es la columna, no lito_eval()
)
cat("Predicción (log-intensidad) - min:", round(min(pred_lito$mean),2),
" max:", round(max(pred_lito$mean),2),
" mediana:", round(median(pred_lito$mean),2), "\n")
# 4) Mapa
ggplot() +
gg(pred_lito, aes(fill = mean), geom = "tile") +
scale_fill_viridis_c(option = "inferno") +
coord_equal() +
labs(title = "Mapa de prospectividad de Au (LGCP con litología)",
subtitle = "Log-intensidad = campo espacial + litología",
fill = "log λ(s)") +
theme_minimal()
library(sf)
library(terra)
library(ggplot2)
# ---- 1) Guardar el mapa como imagen de alta resolución ----
mapa_lgcp <- ggplot() +
gg(pred_lito, aes(fill = mean), geom = "tile") +
scale_fill_viridis_c(option = "inferno") +
coord_equal() +
labs(title = "Mapa de prospectividad de Au (LGCP con litología)",
subtitle = "Log-intensidad esperada = campo espacial + litología",
fill = "log λ(s)") +
theme_minimal()
ggsave("MapaProspectividad_LGCP.png", mapa_lgcp, width = 8, height = 10, dpi = 300)
# ---- 2) Convertir la predicción a raster GeoTIFF ----
# pred_lito es un objeto sf de píxeles; extraemos coords y valores
coords_pix <- st_coordinates(pred_lito)
df_pred <- data.frame(x = coords_pix[,1] * 1000,   # volver a metros
y = coords_pix[,2] * 1000,
log_intensidad = pred_lito$mean,
intensidad     = exp(pred_lito$mean))
# Crear raster (resolución ~ la de la grilla; ajústala si hace falta)
r_log <- rast(df_pred[, c("x","y","log_intensidad")], type = "xyz", crs = "EPSG:21897")
r_int <- rast(df_pred[, c("x","y","intensidad")],     type = "xyz", crs = "EPSG:21897")
writeRaster(r_log, "Prospectividad_LGCP_log.tif", overwrite = TRUE)
writeRaster(r_int, "Prospectividad_LGCP_intensidad.tif", overwrite = TRUE)
# ---- 3) Guardar también como GeoPackage vectorial (píxeles como polígonos/puntos) ----
pred_export <- pred_lito
pred_export$log_intensidad <- pred_lito$mean
pred_export$intensidad     <- exp(pred_lito$mean)
# Reproyectar de km a metros para QGIS
st_geometry(pred_export) <- st_geometry(pred_export) * 1000
st_crs(pred_export) <- 21897
st_write(pred_export, "Prospectividad_LGCP.gpkg", delete_dsn = TRUE)
cat("Exportado:\n - MapaProspectividad_LGCP.png\n - Prospectividad_LGCP_log.tif\n",
"- Prospectividad_LGCP_intensidad.tif\n - Prospectividad_LGCP.gpkg\n")
