# 1) ¿Qué objetos tengo vivos en la sesión de R?
ls()
# 2) ¿Existe el modelo ajustado en memoria?
exists("modelo_bru_lito")
# 3) ¿Qué archivos .gpkg tengo en la carpeta del proyecto?
list.files(pattern = "\\.gpkg$", recursive = TRUE)
# ============================================================
#  LGCP de prospectividad de Au — script completo
#  Reconstruye el modelo y genera media + INCERTIDUMBRE
# ============================================================
library(INLA)
library(inlabru)
library(sf)
library(ggplot2)
# ── 0) Ruta de trabajo (ajústala a tu carpeta) ──
setwd("C:/Users/USUARIO/Documents/ESPECIALIZACION_GNM/ANALISIS_GEOESPACIAL/AnalisisGeoespacial_2026")
# ── 1) Cargar los datos (los .gpkg que ya tienes) ──
puntos_sf  <- st_read("puntos_au.gpkg")       # 1.835 ocurrencias de Au
area_sf    <- st_read("area_trabajo.gpkg")    # área de estudio (polígono)
reticula   <- st_read("reticula_lito.gpkg")   # retícula con la litología
# Aseguramos EPSG:21897 y geometrías válidas
puntos_sf <- st_transform(puntos_sf, 21897)
area_sf   <- st_make_valid(st_transform(area_sf, 21897))
reticula  <- st_transform(reticula, 21897)
# ── 2) Coordenadas en km (el modelo trabaja en km, no en metros) ──
coords    <- st_coordinates(puntos_sf)
coords_km <- coords / 1000
# ── 3) Construir la malla de triángulos (andamiaje SPDE) ──
borde <- inla.nonconvex.hull(coords_km, convex = -0.04, concave = -0.04)
malla <- inla.mesh.2d(boundary = borde,
max.edge = c(8, 40),   # tamaño de triángulo (interior, exterior)
cutoff   = 4,          # distancia mínima entre nodos
offset   = c(8, 40))
cat("Nodos de la malla:", malla$n, "\n")     # ~3.934
# ── 4) Definir el campo gaussiano Matérn (SPDE) con priores PC ──
spde <- inla.spde2.pcmatern(
mesh        = malla,
alpha       = 2,                    # nu = 1 (suavidad)
prior.range = c(15, 0.5),           # P(rango < 15 km) = 0.5
prior.sigma = c(1, 0.01)            # P(sigma > 1) = 0.01
)
# ── 5) Preparar la litología como covariable espacial ──
# Función que, para unas coordenadas, devuelve la litología de la celda que las contiene.
reticula_km <- st_as_sf(st_geometry(reticula) / 1000, crs = NA)
reticula_km$lito_grupo <- reticula$lito_grupo
f_lito <- function(x, y) {
pts <- st_as_sf(data.frame(x = x, y = y), coords = c("x", "y"), crs = NA)
idx <- st_intersects(pts, reticula_km)
out <- sapply(idx, function(i) if (length(i) > 0) reticula_km$lito_grupo[i[1]] else NA)
factor(out, levels = levels(factor(reticula_km$lito_grupo)))
}
# ── 6) Dominio para inlabru (área en km, geometría válida) ──
area_km <- st_sf(geometry = st_sfc(
st_make_valid(st_geometry(area_sf) / 1000)))
st_crs(area_km) <- NA
puntos_km_sf <- st_as_sf(as.data.frame(coords_km),
coords = c("X", "Y"), crs = NA)
# ── 7) Componente del modelo: campo gaussiano + litología + intercepto ──
cmp <- geometry ~ campo(geometry, model = spde) +
lito(f_lito(st_coordinates(.data.)[,1],
st_coordinates(.data.)[,2]), model = "factor_contrast") +
Intercept(1)
# ── 8) Ajustar el LGCP (aquí ocurre la magia, ~9 segundos) ──
modelo_bru_lito <- lgcp(
components = cmp,
data       = puntos_km_sf,
samplers   = area_km,
domain     = list(geometry = malla)
)
summary(modelo_bru_lito)
# ============================================================
#  9) PREDICCIÓN: media E INCERTIDUMBRE sobre una grilla fina
# ============================================================
# Grilla de predicción (píxeles) dentro del área
pixels_pred <- fm_pixels(malla, mask = area_km, dims = c(300, 300))
# Pre-calculamos la litología en cada píxel (necesario para predecir)
coords_pix <- st_coordinates(pixels_pred)
pixels_pred$lito <- f_lito(coords_pix[,1], coords_pix[,2])
# Predecimos la intensidad: campo + litología + intercepto
# 'predict' devuelve mean, sd, q0.025, q0.975...  -> 'sd' es la INCERTIDUMBRE
pred <- predict(modelo_bru_lito, pixels_pred,
~ campo + lito + Intercept)
# ── 10) MAPA DE MEDIA (prospectividad) ──
mapa_media <- ggplot() +
gg(pred, aes(fill = mean), geom = "tile") +
scale_fill_viridis_c(option = "inferno", name = "log-intensidad") +
coord_equal() +
labs(title = "LGCP — Media posterior (prospectividad de Au)") +
theme_minimal()
ggsave("LGCP_media.png", mapa_media, width = 8, height = 7, dpi = 200)
# ── 11) MAPA DE INCERTIDUMBRE (lo que buscábamos) ──
mapa_sd <- ggplot() +
gg(pred, aes(fill = sd), geom = "tile") +
scale_fill_viridis_c(option = "viridis", name = "desv. estándar") +
coord_equal() +
labs(title = "LGCP — Incertidumbre (desviación estándar posterior)",
subtitle = "Más claro = mayor incertidumbre") +
theme_minimal()
ggsave("LGCP_incertidumbre.png", mapa_sd, width = 8, height = 7, dpi = 200)
cat("Listo. Generados: LGCP_media.png y LGCP_incertidumbre.png\n")
